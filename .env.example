# How many Cursor agents run at once. Each one keeps its own conversation.
AI_CONCURRENCY=4

# AI backend: "cursor" (cursor-agent CLI), "claude" (Claude API), or
# "claude-cli" (spawns `claude -p`, uses your Claude Code login).
AI_BACKEND=cursor
# Required when AI_BACKEND=claude.
# ANTHROPIC_API_KEY=
# Model for the claude and claude-cli backends.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CLI_PATH=claude
