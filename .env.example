# Path to your existing Chrome binary (NixOS home-manager profile)
CHROME_PATH=/etc/profiles/per-user/aris/bin/google-chrome-stable

# Automation profile (Chrome 136+ blocks remote debugging on the default profile).
# Copy logins from your everyday Chrome with: npm run chrome:seed
CHROME_USER_DATA_DIR=$HOME/.config/google-chrome-automation

# Remote debugging endpoint — use with PUPPETEER_MODE=connect
CHROME_DEBUG_URL=http://127.0.0.1:9222

# connect = attach to Chrome you already opened (keeps logins, Chrome can stay open)
# launch  = spawn Chrome with your profile (close all Chrome windows first)
PUPPETEER_MODE=connect

# Only for launch mode
HEADLESS=false
